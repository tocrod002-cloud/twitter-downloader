{
  "name": "twitter-downloader",

  "main": "./src/index.js",

  "compatibility_date": "2026-09-28",

  "workers_dev": true,

  "assets": {
    "directory": "./public",

    "binding": "ASSETS",

    "run_worker_first": [
      "/api",
      "/api/*",
      "/download",
      "/download/*"
    ]
  }
}
